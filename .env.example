# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit real credentials.

# Day 54 – SMTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=you@example.com

# Day 60 – API authentication demos (httpbin.org accepts any values)
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_BEARER_TOKEN=
DEMO_API_KEY=

# Day 61 – Twilio SMS (leave blank to stay in dry-run mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_TO_NUMBER=
